NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_NAME=PLP Enrollment System

# Enrollment project's server-only Supabase key. Use the Enrollment project's
# secret key (sb_secret_...) or legacy service_role key. Never expose it to a browser.
# The Enrollment database URL above and this key must belong to the SAME project.
# The Admissions Supabase key is configured only in the Admissions project.
SUPABASE_SECRET_KEY=
# Legacy alternative if you use a service_role key:
# SUPABASE_SERVICE_ROLE_KEY=
AUTH_IDENTIFIER_HASH_SECRET=

# Shared server-to-server secret for PLP Admissions -> Enrollment intake.
# Keep this identical to ENROLLMENT_INTAKE_SECRET in Admissions and server-only.
ENROLLMENT_INTAKE_SECRET=

# OFF by default: enabling this sends REAL Supabase Auth invitation emails
# for successful, accepted PLP Admissions handoffs. Configure the Supabase
# Invite email template, SMTP and allowed redirect URLs before enabling.
# The System Administrator can reconcile earlier handoffs from System Integration.
ADMISSIONS_AUTO_PROVISION_ENABLED=false
ADMISSIONS_INVITE_REDIRECT_URL=http://localhost:3000/activate-student-account
