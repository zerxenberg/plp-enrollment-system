# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local and deployment environment credentials.
.env
.env.*
!.env.example
*.vault
*.vault.*
*.key
*.p12
*.pfx
*.dump
*.backup

# Generated synthetic archive SQL batches; source manifest is under docs/
supabase/seed/.phase3b-archive-batches/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# typescript

# Keep ad hoc SQL exports and local database dumps out of Git.
*.sql

# Only reviewed migration sources should be added explicitly.
!/supabase/migrations/*.sql

# Fictional project cohort and credential handoff exports are operator held.
/supabase/seed/*.csv
/scripts/database-normalization/project-auth/*.vault*
/scripts/database-normalization/project-auth/*handoff*.json
/scripts/database-normalization/project-auth/*credentials*.csv

# Locally generated fictional Phase 8 cohort identity snapshots and manifests.
# Keep student UUID data in private local storage, never Git.
/scripts/database-normalization/academic-phase8/cohort-phase8-payload-*.json
/scripts/database-normalization/academic-phase8/*-snapshot*.json
/scripts/database-normalization/academic-phase8/*-manifest*.json
